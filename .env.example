# Required: Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Required: NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-secret-here"

# Required for Google sign-in and Gmail scanning
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Optional: enables AI extraction via Groq (https://console.groq.com/keys).
# PingMate uses a conservative local keyword fallback without it.
GROQ_API_KEY="gsk_..."
# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL="openai/gpt-oss-120b"

# Optional: enables WhatsApp verification and reminder delivery. The dashboard still works without it.
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"

# Required in production for Vercel Cron; use a long random value locally if testing the endpoint.
CRON_SECRET="your-random-secret-for-cron"

# Optional public display value only (never put secrets in NEXT_PUBLIC variables)
NEXT_PUBLIC_TWILIO_SANDBOX_NUMBER="+14155238886"
# The "join <word>" phrase shown in your Twilio console's WhatsApp sandbox page
NEXT_PUBLIC_TWILIO_SANDBOX_JOIN_CODE="join your-sandbox-word"

# Optional: add comma-separated domains if your college sends Recruitsage
# notifications from an address that does not include the word "recruitsage".
# RECRUITSAGE_SENDER_DOMAINS="notifications.yourcollege.edu,placement.yourcollege.edu"
