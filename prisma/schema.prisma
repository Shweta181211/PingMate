generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String        @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
  emails        Email[]
  opportunities Opportunity[]
  reminders     Reminder[]
  sessions      Session[]
  settings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Email {
  id          String       @id @default(cuid())
  userId      String
  gmailId     String       @unique
  subject     String
  sender      String
  senderEmail String
  snippet     String?
  body        String
  receivedAt  DateTime
  analyzed    Boolean      @default(false)
  // false until the email has been classified by the AI model (or skipped by
  // the local keyword filter). Lets keyword-fallback results be upgraded later.
  aiAnalyzed  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity Opportunity?
}

model Opportunity {
  id               String              @id @default(cuid())
  userId           String
  emailId          String?             @unique
  title            String
  companyName      String?
  category         OpportunityCategory
  deadline         DateTime?
  registrationLink String?
  actionRequired   String?
  priority         Priority            @default(MEDIUM)
  status           OpportunityStatus   @default(PENDING)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  email            Email?              @relation(fields: [emailId], references: [id])
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminders        Reminder[]
}

model Reminder {
  id            String         @id @default(cuid())
  userId        String
  opportunityId String
  scheduledAt   DateTime
  sentAt        DateTime?
  message       String
  status        ReminderStatus @default(PENDING)
  type          ReminderType
  createdAt     DateTime       @default(now())
  opportunity   Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id                  String    @id @default(cuid())
  userId              String    @unique
  whatsappNumber      String?
  whatsappVerified    Boolean   @default(false)
  whatsappOtpHash     String?
  whatsappOtpExpiresAt DateTime?
  remindersEnabled    Boolean   @default(true)
  reminderDayBefore   Boolean   @default(true)
  reminderSameDayMorn Boolean   @default(true)
  reminderFourHours   Boolean   @default(true)
  // Time of day (HH:mm, India time) for the day-before and same-day reminders
  reminderTime        String    @default("09:00")
  // Hours before the deadline for the last-chance reminder
  reminderHoursBefore Int       @default(4)
  whatsappLastError   String?
  whatsappLastErrorAt DateTime?
  gmailConnected      Boolean   @default(false)
  lastGmailSync       DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OpportunityCategory {
  INTERNSHIP
  PLACEMENT
  INTERVIEW
  HACKATHON
  COMPETITION
  SCHOLARSHIP
  EVENT
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum OpportunityStatus {
  PENDING
  APPLIED
  IGNORED
  MISSED
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum ReminderType {
  DAY_BEFORE
  SAME_DAY_MORNING
  FOUR_HOURS_BEFORE
  CUSTOM
}
